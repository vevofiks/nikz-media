.env
.env.*
!.env.example

# vercel / deploy
.vercel
.netlify

# typescript
*.tsbuildinfo

# editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# local agent / Cursor tooling (not for production repo)
.agents/
.cursor/
.taste-skill/
skills-lock.json

# CMS runtime data (submitted inquiries; keep site.json tracked)
/data/inquiries.json

